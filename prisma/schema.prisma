generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  googleSubject String?   @unique
  timezone      String    @default("America/New_York")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  myDayItems           MyDayItem[]
  calendarEvents       CalendarEventCache[]
  pushSubscriptions    PushSubscription[]
  googleCalendarTokens GoogleCalendarToken?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Workspaces ───────────────────────────────────────────────

enum WorkspaceType {
  personal
  shared
}

enum MembershipRole {
  owner
  member
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  type      WorkspaceType @default(personal)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships Membership[]
  lists       List[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(owner)
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("memberships")
}

// ─── Lists & Tasks ────────────────────────────────────────────

model List {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  isInbox     Boolean   @default(false)
  sortOrder   Int       @default(0)
  // Streams: non-inbox lists are life streams with a color and an importance weight
  color       String?
  weight      Int       @default(20)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]
  goals     Goal[]

  @@index([workspaceId])
  @@map("lists")
}

model Goal {
  id         String    @id @default(cuid())
  listId     String
  title      String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  list  List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([listId])
  @@map("goals")
}

enum TaskKind {
  flex
  template
}

enum AttentionCost {
  deep
  light
  any
}

enum TaskPriority {
  none
  low
  medium
  high
}

model Task {
  id               String        @id @default(cuid())
  listId           String
  goalId           String?
  sortOrder        Int           @default(0)
  title            String
  notes            String?       @db.Text
  priority         TaskPriority  @default(none)
  kind             TaskKind      @default(flex)
  attentionCost    AttentionCost @default(any)
  estimatedMinutes Int?
  dueAt            DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  list           List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  goal           Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recurrenceRule RecurrenceRule?
  occurrences    TaskOccurrence[]

  @@index([listId])
  @@index([goalId])
  @@map("tasks")
}

enum AlarmPolicy {
  none
  gentle
  panic
}

enum RecurrenceMode {
  habit
  rolling
  fixed
}

model RecurrenceRule {
  id           String         @id @default(cuid())
  taskId       String         @unique
  mode         RecurrenceMode @default(rolling)
  // Structured recurrence (not full RRULE parity)
  frequency    String // daily | weekly | monthly
  interval     Int            @default(1)
  byWeekday    Int[] // 0=Sun .. 6=Sat for weekly
  skippable    Boolean        @default(true)
  alarmPolicy  AlarmPolicy    @default(none)
  // Optional daily window "do between HH:MM" (local time strings)
  windowStart  String? // "08:00"
  windowEnd    String? // "10:00"
  // Rolling/habit: single source of truth for the open chip
  nextDueAt    DateTime?
  // Seasonal: empty = all year (1=Jan .. 12=Dec)
  activeMonths Int[]          @default([])
  pauseUntil   DateTime?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("recurrence_rules")
}

enum OccurrenceStatus {
  pending
  done
  skipped
  missed
  snoozed
  expired
}

model TaskOccurrence {
  id                  String           @id @default(cuid())
  taskId              String
  date                DateTime         @db.Date
  status              OccurrenceStatus @default(pending)
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  skippableSnapshot   Boolean          @default(true)
  alarmPolicySnapshot AlarmPolicy      @default(none)
  calendarEventId     String?
  // Original due before soft slide-to-today
  dueSince            DateTime?        @db.Date
  skipReason          String?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  alarmEvents AlarmEvent[]

  @@unique([taskId, date])
  @@index([date, status])
  @@index([taskId, status])
  @@map("task_occurrences")
}

// ─── My Day ───────────────────────────────────────────────────

enum MyDayRefType {
  occurrence
  flex
  calendar
}

enum MyDaySource {
  manual
  suggested
}

model MyDayItem {
  id        String       @id @default(cuid())
  userId    String
  date      DateTime     @db.Date
  refType   MyDayRefType
  refId     String
  sortOrder Int          @default(0)
  pinned    Boolean      @default(false)
  source    MyDaySource  @default(manual)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, refType, refId])
  @@index([userId, date])
  @@map("my_day_items")
}

// ─── Calendar ─────────────────────────────────────────────────

enum AttentionMode {
  full
  partial
  idle
}

model CalendarEventCache {
  id            String        @id @default(cuid())
  userId        String
  googleEventId String
  calendarId    String        @default("primary")
  title         String
  location      String?
  description   String?       @db.Text
  start         DateTime
  end           DateTime
  allDay        Boolean       @default(false)
  attentionMode AttentionMode @default(full)
  moveable      Boolean       @default(false)
  syncedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, start, end])
  @@map("calendar_event_cache")
}

model GoogleCalendarToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_tokens")
}

// ─── Alarms & Push ────────────────────────────────────────────

enum AlarmChannel {
  webpush
  email
}

model AlarmEvent {
  id           String       @id @default(cuid())
  occurrenceId String
  level        Int          @default(1)
  fireAt       DateTime
  deliveredAt  DateTime?
  channel      AlarmChannel @default(webpush)
  createdAt    DateTime     @default(now())

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([fireAt, deliveredAt])
  @@map("alarm_events")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
