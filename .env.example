# Environment
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5432/taskmanager?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="dev-secret-change-me-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google accounts allowed to sign in (comma-separated). Empty = nobody in production.
AUTH_ALLOWED_EMAILS=""

# Passwordless dev login for local work only. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="1"

# Google OAuth (required for Google sign-in + calendar)
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Cron / job secret for alarm escalator & materializer
CRON_SECRET="dev-cron-secret"

# LLM task timing (OpenAI-compatible). Optional — falls back to heuristics.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
